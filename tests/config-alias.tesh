$ cd blank

# Setup note fixtures.
$ mkdir "red planet"
$ touch "without-title.md"
$ echo -e "# Yellow sun" > "yellow-sun.md"
$ touch "red planet/blue moon.md"

# Alias to override the default flags of a command.
$ echo -e "[alias] list = 'zk list --quiet -fpath \$@'" > .zk/config.toml
$ zk list -n2 --sort path-
>yellow-sun.md
>without-title.md

# Shortcut for a native command.
$ echo -e "[alias] ls = 'zk list \$@'" > .zk/config.toml
$ zk ls --quiet -fpath
>red planet/blue moon.md
>without-title.md
>yellow-sun.md

# Use $*
$ echo -e "[note] filename = '\{{slug title}}'\n [alias] nt = 'zk new --dry-run --title \"\$*\"'" > .zk/config.toml
$ zk nt Hello world
2>{{working-dir}}/hello-world.md

# Use the `ZK_NOTEBOOK_DIR` env variable.
$ echo -e "[alias] nbdir = 'echo \$ZK_NOTEBOOK_DIR'" > .zk/config.toml
$ zk nbdir
>{{working-dir}}

# Test the "xargs formula"
$ echo -e "[alias] xargs = 'zk list --quiet --format path --delimiter0 | xargs -0 head'" > .zk/config.toml
$ zk xargs
>==> red planet/blue moon.md <==
>
>==> without-title.md <==
>
>==> yellow-sun.md <==
># Yellow sun

# An alias can also be declared as a table, which is how it gets a
# description.
$ echo -e "[alias.nbdir]\nalias = 'echo \$ZK_NOTEBOOK_DIR'\ndescription = 'Print the notebook directory'" > .zk/config.toml

$ zk nbdir
>{{working-dir}}

# The description is listed with the command the alias runs.
$ zk config --list aliases --format full
>       nbdir    echo $ZK_NOTEBOOK_DIR    # Print the notebook directory
2>
2>Found 1 aliases

# Both forms can be mixed in the same section.
$ echo -e "[alias]\nls = 'zk list \$@'\n[alias.nbdir]\nalias = 'echo \$ZK_NOTEBOOK_DIR'\ndescription = 'Print the notebook directory'" > .zk/config.toml

$ zk config --list aliases --format full
>          ls    zk list $@
>       nbdir    echo $ZK_NOTEBOOK_DIR    # Print the notebook directory
2>
2>Found 2 aliases

# The table form must say which command to run.
$ echo -e "[alias.nbdir]\ndescription = 'Print the notebook directory'" > .zk/config.toml

1$ zk nbdir
2>zk: error: failed to open notebook config: failed to read alias `nbdir`: missing the `alias` property with the command to run

# A misspelled property is reported rather than ignored.
$ echo -e "[alias.nbdir]\nalias = 'echo'\ndescriptn = 'Oops'" > .zk/config.toml

1$ zk nbdir
2>zk: error: failed to open notebook config: failed to read alias `nbdir`: unknown property `descriptn`, expected `alias` or `description`

# The aliases are presented as commands of their own, so that the help lists
# them. An alias with no description of its own is shown by the command it
# runs. The shell completions are covered by cmd-completion.tesh.
$ echo -e "[alias]\nlucky = 'zk list --sort random --limit 1'\n[alias.nbdir]\nalias = 'echo \$ZK_NOTEBOOK_DIR'\ndescription = 'Print the notebook directory'" > .zk/config.toml

$ zk --help | grep -A4 ALIASES
>ALIASES
>  Your own commands, declared in the notebook's configuration
>
>  lucky    zk list --sort random --limit 1
>  nbdir    Print the notebook directory

# An alias overriding one of zk's own commands is not listed twice: the
# command keeps its place, and the alias still runs in front of it.
$ echo -e "[alias]\nlist = 'echo overridden'" > .zk/config.toml

1$ zk --help | grep -c ALIASES
>0

$ zk list
>overridden

